# Leave AI_PROVIDER empty for the built-in deterministic demo companion.
# Supported values: qwen, deepseek, doubao, kimi
AI_PROVIDER=

# Alibaba Cloud Model Studio / Qwen, China (Beijing).
# The stable workspace URL is recommended for production. The legacy Beijing
# URL below is also allowlisted; replace it with:
# https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Reproducible snapshots verified for the Beijing region.
QWEN_MODEL=qwen3.7-plus-2026-05-26
QWEN_ASR_MODEL=qwen3-asr-flash-2026-02-10

# DeepSeek (official OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Doubao / Volcengine Ark (official OpenAI-compatible endpoint)
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# Kimi / Moonshot China (official OpenAI-compatible endpoint)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# Set these before collecting real student records. Keep the pepper stable;
# changing it makes earlier participant codes unable to find their records.
PARTICIPANT_HASH_PEPPER=
TEACHER_ACCESS_KEY=
