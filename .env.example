# The full-stack service currently enables only the independently reviewed
# Alibaba Cloud Model Studio / Qwen path. Missing or invalid configuration
# fails closed with HTTP 503; no provider key belongs in source control.
AI_PROVIDER=qwen

# China (Beijing). Use a dedicated workspace URL for a real controlled pilot:
# https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# The legacy Beijing URL below remains allowlisted for local development.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Exact snapshots reviewed on 2026-08-12. The server rejects floating aliases
# or different snapshots so a study deployment remains reproducible.
QWEN_MODEL=qwen3.7-plus-2026-05-26
QWEN_ASR_MODEL=qwen3-asr-flash-2026-02-10
QWEN_TTS_MODEL=qwen3-tts-instruct-flash-2026-01-26

# Required only for the first controlled deployment. Use a random secret of at
# least 24 characters. POST /api/auth/bootstrap accepts it exactly once; after
# the first teacher exists the database permanently closes bootstrap.
AUTH_BOOTSTRAP_TOKEN=

# v5.1 Alibaba Cloud / Node runtime only. Keep this in the server secret store;
# the browser must never receive it. Apply postgres/0001_v5_1_system.sql before
# starting the service. The existing Cloudflare/D1 deployment ignores it.
DATABASE_URL=
# Production defaults to TLS with certificate verification. Only an isolated
# local PostgreSQL development instance may explicitly opt out with true.
DATABASE_ALLOW_INSECURE_LOCAL=false
# Required for the public EITT demonstration. This blocks student-account
# creation; use adult researchers and synthetic records only.
PUBLIC_DEMO_MODE=true
# Fail closed. Missing/true means adult evaluation only; only explicit false
# enables any student login or student-data API. Keep true for personal EITT.
ADULT_EVALUATION_ONLY=true

# Adult-operated synthetic school sandbox. Keep ADULT_EVALUATION_ONLY=true and
# enable this only on a dedicated empty database. All school-domain rows must
# carry synthetic=1 or startup fails closed. The admin key is server-only and
# is never sent to ordinary browsers; use at least 24 random characters.
SANDBOX_MODE=false
SANDBOX_ADMIN_KEY=

# Adult teacher/expert evaluation. Use unique, random, one-time codes separated
# by commas. Never use names, phone numbers, schools or student identifiers.
EVALUATION_TEACHER_CODES=
EVALUATION_EXPERT_CODES=
# At least 16 random characters; keep only in the server secret store.
RESEARCH_ACCESS_KEY=
# Required public study information. Collection fails closed until every field
# is configured with the wording approved for the adult evaluation protocol.
EVALUATION_RESEARCHER_NAME=
EVALUATION_CONTACT=
EVALUATION_ETHICS_STATUS=Protocol pending; formative prototype feedback only
EVALUATION_RETENTION_DAYS=365
