{
  admin off
}

{$SITE_HOSTNAME} {
  encode zstd gzip
  request_body {
    max_size 12MB
  }
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), geolocation=(), payment=()"
    -Server
  }
  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 30s
    health_timeout 5s
    transport http {
      response_header_timeout 60s
    }
  }
}
