# Public DNS name already pointing at this server. Do not include https://.
SITE_HOSTNAME=xinban.example.com

# URL-safe random value only (letters, digits, hyphen, underscore).
POSTGRES_PASSWORD=replace_with_url_safe_random_value

AI_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus-2026-05-26
QWEN_ASR_MODEL=qwen3-asr-flash-2026-02-10
QWEN_TTS_MODEL=qwen3-tts-instruct-flash-2026-01-26

PUBLIC_DEMO_MODE=true
ADULT_EVALUATION_ONLY=true
SANDBOX_MODE=true
SANDBOX_ADMIN_KEY=replace_with_at_least_24_random_characters

# Comma-separated, unique, one-time codes (minimum eight characters each).
EVALUATION_TEACHER_CODES=replace_teacher_code_1,replace_teacher_code_2
EVALUATION_EXPERT_CODES=replace_expert_code_1,replace_expert_code_2
RESEARCH_ACCESS_KEY=replace_with_at_least_16_random_characters
EVALUATION_RESEARCHER_NAME=replace_with_researcher_name
EVALUATION_CONTACT=replace_with_contact_method
EVALUATION_ETHICS_STATUS=Protocol pending; formative prototype feedback only
EVALUATION_RETENTION_DAYS=365
EVALUATION_DATA_HOST=Alibaba Cloud Hong Kong protected evaluation database
